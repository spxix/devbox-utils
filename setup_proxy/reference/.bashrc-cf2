# Base64 快捷函数
b64e() {
    # 编码: b64e "string" 或 echo "string" | b64e
    if [ -n "$1" ]; then
        echo -n "$1" | base64
    else
        base64
    fi
}

b64d() {
    # 解码: b64d "base64string" 或 echo "base64string" | b64d
    if [ -n "$1" ]; then
        echo "$1" | base64 -d
    else
        base64 -d
    fi
}

# Git branch protection wrapper
git() {
  local protected_branches="cc/origin/main"
  if [[ "$1" == "branch" && ("$2" == "-d" || "$2" == "-D") ]]; then
    for branch in $protected_branches; do
      if [[ "$3" == "$branch" ]]; then
        echo "Error: Branch '$branch' is protected and cannot be deleted."
        return 1
      fi
    done
  fi
  command git "$@"
}

