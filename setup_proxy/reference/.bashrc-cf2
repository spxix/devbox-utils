# tmux alias
alias tmuxn='tmux new -s'
alias tmuxl='tmux list-session'
alias tmuxa='tmux attach-session -t'
alias tmuxk='tmux kill-session -t'

# tmux session name completion fallback (used when system tmux completion is absent).
_tmux_session_name_complete() {
    local cur prev cmd words
    COMPREPLY=()
    cmd="${COMP_WORDS[0]}"
    cur="${COMP_WORDS[COMP_CWORD]}"
    prev="${COMP_WORDS[COMP_CWORD-1]}"

    if [[ ( "$cmd" == "tmuxa" || "$cmd" == "tmuxk" ) && "$COMP_CWORD" -eq 1 ]]; then
        words="$(tmux list-sessions -F '#S' 2>/dev/null)"
        COMPREPLY=( $(compgen -W "$words" -- "$cur") )
        return 0
    fi

    if [[ "$prev" == "-t" || "$prev" == "--target-session" ]]; then
        words="$(tmux list-sessions -F '#S' 2>/dev/null)"
        COMPREPLY=( $(compgen -W "$words" -- "$cur") )
        return 0
    fi

    if [[ "${COMP_WORDS[1]}" == "attach" || "${COMP_WORDS[1]}" == "attach-session" ]]; then
        words="$(tmux list-sessions -F '#S' 2>/dev/null)"
        COMPREPLY=( $(compgen -W "$words" -- "$cur") )
        return 0
    fi
}

if ! complete -p tmux >/dev/null 2>&1; then
    complete -o default -F _tmux_session_name_complete tmux
fi
complete -o default -F _tmux_session_name_complete tmuxa tmuxk

