export HISTTIMEFORMAT="%h %d %H:%M:%S "
export HISTSIZE=100000

parse_git_branch() {
     git branch 2> /dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/ git:(\1)/'
}
# 显示最后3层目录，不足3层则全部显示
short_pwd() {
    local dir="${PWD/#$HOME/~}"
    echo "$dir" | awk -F'/' '{
        n = NF
        if (n <= 3) { print $0 }
        else { print $(n-2)"/"$(n-1)"/"$n }
    }'
}
GREEN='\[\033[00;32m\]'
WHITE='\[\033[01;37m\]'
RED='\[\033[00;31m\]'
RESTORE='\[\033[0m\]'
PS1="\[\033[01;32m\][\$(date +'%Y-%m-%d') \t]\[\033[00m\] ${WHITE}\$(short_pwd)${RED}\$(parse_git_branch) ${RESTORE}\$ "

