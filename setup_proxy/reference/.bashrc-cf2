# Claude CLI VPN 检查包装
claude() {
    if curl -sI --max-time 5 www.google.com 2>/dev/null | head -1 | grep -q "200"; then
        /root/.local/bin/claude "$@"
    else
        echo -e "\033[31mVPN 未生效，不能使用 claude\033[0m"
        return 1
    fi
}
